{
  "name": "buglab-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "db:setup": "prisma migrate dev --name init && npm run db:seed",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
