generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bug {
  id               Int       @id @default(autoincrement())
  title            String
  description      String
  difficulty       String
  brokenCode       String
  expectedBehavior String
  attempts         Attempt[]
  createdAt        DateTime  @default(now())
}

model Attempt {
  id         Int      @id @default(autoincrement())
  bugId      Int
  diagnosis  String
  correct    Boolean
  createdAt  DateTime @default(now())
  bug        Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
}
